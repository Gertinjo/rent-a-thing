# Copy this file to backend/.env and paste ONE key. backend/.env is git-ignored — never commit it.
# Changes are picked up automatically (no restart needed). First key found wins: Gemini, Groq, Claude.

# FREE: Google Gemini — get a key at https://aistudio.google.com/apikey (no credit card).
# Note: on the free tier Google may use requests to improve its products (only listing photos/text are sent).
GEMINI_API_KEY=

# FREE alternative: Groq — https://console.groq.com/keys
# GROQ_API_KEY=

# Paid alternative (~$0.001 per use): Anthropic Claude — https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional overrides
# AI_PROVIDER=gemini        # gemini | groq | anthropic
# AI_MODEL=gemini-3.5-flash-lite
# AI_DISABLED=1             # switch AI off without deleting keys

# ---- Payments (DEMO ONLY) ----
# Without a key the app uses a built-in demo checkout (test card 4242 4242 4242 4242).
# For real Stripe Checkout in TEST MODE: create a free Stripe account, switch the dashboard to
# "Test mode", copy the secret key from Developers -> API keys. Live keys (sk_live_) are ignored.
# STRIPE_SECRET_KEY=sk_test_...
# Optional: webhooks (needs the Stripe CLI: stripe listen --forward-to localhost:8000/payments/webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
